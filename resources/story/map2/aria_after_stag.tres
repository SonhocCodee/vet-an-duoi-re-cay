speaker_name = "Aria"
lines = Array[String](["Khoan... đường kiếm đó. Ta đã thấy nó trong đêm khu rừng cháy.", "Tên ta là Aria. Ta nợ ngươi một lời giải thích, nhưng nơi này không an toàn.", "Cổng thị trấn ở phía đông. Đi cùng ta — nếu ngươi vẫn còn muốn biết mình là ai."])
