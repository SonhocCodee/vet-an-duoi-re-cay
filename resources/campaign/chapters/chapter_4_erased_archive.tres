title = "Thư Viện Tên Bị Xóa"
subtitle = "Lịch sử cháy sạch trước khi mực kịp khô"
intro_lines = Array[String](["Elysia dẫn Kael đến kho lưu trữ nơi gia tộc cô từng phục vụ Giáo Hội.", "Mỗi cuốn sách bị mở đều quên tên tác giả, còn người đọc dần quên chính mình.", "Một quản thủ không mặt đang xóa dấu vết về Kẻ Giữ Rễ khỏi lịch sử."])
objective = "Khôi phục ba mục lục ký ức, bảo vệ các bản ghi còn lại và đánh bại quản thủ đã xóa tên Kael."
companion = &"elysia"
completion_lines = Array[String](["Tên Kael trở lại trên một trang giấy, cạnh hàng nghìn cái tên chưa ai nhớ tới.", "Elysia giữ bản sao lời thú tội của gia tộc mình thay vì giấu nó thêm một lần nữa."])
