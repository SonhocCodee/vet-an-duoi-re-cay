moral_choice_id = &"choice_chapter_4_archive_names"
moral_option_a_text = "Khôi phục toàn bộ tên đã bị xóa, kể cả tên của những kẻ từng phạm tội."
moral_option_a_flag = &"chapter_4_names_restored"
moral_option_b_text = "Niêm phong các bản ghi nguy hiểm nhưng trao sự thật về Kael cho dân chúng."
moral_option_b_flag = &"chapter_4_archive_sealed"
