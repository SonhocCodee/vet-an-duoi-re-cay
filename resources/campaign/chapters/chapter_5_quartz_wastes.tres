moral_option_a_text = "Mở giếng cho mọi đoàn người đi qua, chấp nhận nguy cơ nguồn nước sớm cạn."
moral_option_a_flag = &"chapter_5_well_shared"
moral_option_b_text = "Giao giếng cho cộng đồng lưu vong quản lý và giới hạn người ngoài."
