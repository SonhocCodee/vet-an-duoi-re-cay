title = "Hoang Mạc Thạch Anh"
subtitle = "Mỗi ảo ảnh đều phản chiếu một lời thú tội"
intro_lines = Array[String](["Cát trắng cắt vào giáp như mảnh kính, phản chiếu vô số phiên bản của Kael.", "Elysia tìm thấy dấu vết đoàn pháp sư đã khai thác rễ hóa thạch cho Giáo Hội.", "Giữa tâm bão, một khổng tượng thạch anh bảo vệ giếng nước cuối cùng của dân lưu vong."])
objective = "Băng qua ba vành đai ảo ảnh, mở giếng thạch anh và phá lõi điều khiển khổng tượng."
companion = &"elysia"
completion_lines = Array[String](["Nước trồi lên giữa cát, đục nhưng không còn mang vị kim loại của phong ấn.", "Elysia thú nhận gia tộc cô đã vẽ bản đồ khai thác đầu tiên và trao nó cho những người sống sót."])
