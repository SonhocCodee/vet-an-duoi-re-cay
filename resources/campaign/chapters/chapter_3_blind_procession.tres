title = "Thánh Lộ Mù"
subtitle = "Đoàn người bước theo ánh sáng không còn tồn tại"
intro_lines = Array[String](["Một đoàn hành hương bị bịt mắt đi mãi trên con đường phủ tro trắng.", "Cecilia nghe thấy lời kinh đã bị đảo ngược trong từng bước chân.", "Ở cuối thánh lộ, một vị thống lĩnh vô hồn vẫn ra lệnh cho đoàn người tiến về vực sâu."])
objective = "Phá ba vòng hộ tống của đoàn hành hương, tìm nguồn thánh ca cưỡng ép và chặn cuộc hành quân."
companion = &"cecilia"
completion_lines = Array[String](["Những dải vải che mắt rơi xuống như tuyết xám.", "Cecilia không nhìn thấy bình minh, nhưng lần đầu tiên cô nghe đoàn người tự chọn hướng đi."])
encounter_enemy_ids = Array[StringName]([&"drowned_axeman", &"soulless_holy_guard", &"blind_battlemage"])
