moral_option_a_text = "Tháo khăn bịt mắt và công bố con đường thật, dù đám đông có thể hoảng loạn."
moral_option_a_flag = &"chapter_3_procession_awakened"
moral_option_b_text = "Dẫn đoàn người đến nơi an toàn trước rồi mới tiết lộ họ đã bị lừa."
moral_option_b_flag = &"chapter_3_procession_sheltered"
reward_exp = 2400
