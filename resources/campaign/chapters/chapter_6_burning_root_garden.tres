title = "Vườn Rễ Thiêu"
subtitle = "Ngọn lửa chữa lành cũng biết cách ăn thịt ký ức"
intro_lines = Array[String](["Một khu vườn khổng lồ cháy suốt nhiều năm mà không hóa thành tro.", "Aria nhận ra lửa được nuôi bằng lời thề của những hiệp sĩ đã chết.", "Mẫu rễ trung tâm vừa chống phong ấn vừa thiêu sống mọi sinh vật đến gần."])
objective = "Dập ba ổ hoa rễ thiêu, giải phóng lời thề mắc kẹt và chặn mẫu thể đang lan lửa xuống Tâm Rễ."
companion = &"aria"
completion_lines = Array[String](["Lửa rút vào lòng đất, để lại những mầm cây đỏ như than hồng.", "Aria đặt thanh kiếm xuống giữa vườn và thừa nhận lời thề không thể thay thế trách nhiệm."])
encounter_enemy_ids = Array[StringName]([&"burning_root_flower", &"betrayer_masked_knight", &"quartz_mummy"])
