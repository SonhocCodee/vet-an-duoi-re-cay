moral_choice_id = &"choice_chapter_6_cinder_garden"
moral_option_a_text = "Dập toàn bộ khu vườn để ngăn lửa lan xuống rễ sâu."
moral_option_a_flag = &"chapter_6_garden_extinguished"
moral_option_b_text = "Giữ lại một lõi lửa đã thanh tẩy để phá phong ấn ở các chương sau."
moral_option_b_flag = &"chapter_6_pure_flame_preserved"
