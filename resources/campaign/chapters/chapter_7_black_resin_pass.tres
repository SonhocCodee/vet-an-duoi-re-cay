[resource]
script = ExtResource("1")
chapter_id = &"chapter_7_black_resin_pass"
chapter_number = 7
title = "Đèo Hắc Tín"
subtitle = "Con đường giữ lại dấu chân của mọi kẻ phản bội"
intro_lines = Array[String](["Nhựa đen phủ kín sườn đèo, đông cứng người và thú thành những cột mốc sống.", "Các thợ săn Hắc Tín gọi Kael là Ma Vương trước cả khi nhìn thấy mặt anh.", "Aria biết đội săn này được lập từ chính quân đoàn từng phục vụ cô."])
objective = "Vượt ba tuyến phục kích, giải phóng đường tiếp tế và đánh bại thủ lĩnh săn người tại đỉnh đèo."
companion = &"aria"
completion_lines = Array[String](["Mưa đầu mùa cuốn nhựa đen khỏi những phiến đá, nhưng không xóa được các vết khắc tên.", "Aria tự ghi tên mình vào danh sách những người phải chịu trách nhiệm."])
encounter_enemy_ids = Array[StringName]([&"black_faith_hunter", &"white_bark_treant", &"soul_black_eagle"])
boss_enemy_id = &"boss_betrayer_knight"
moral_choice_id = &"choice_chapter_7_resin_prisoners"
moral_option_a_text = "Phá toàn bộ cột nhựa và cứu cả những thợ săn từng truy sát dân thường."
moral_option_a_flag = &"chapter_7_resin_prisoners_freed"
moral_option_b_text = "Chỉ cứu nạn nhân vô tội, để các thủ lĩnh săn người bị xét xử tại đèo."
moral_option_b_flag = &"chapter_7_hunters_judged"
reward_exp = 15000
next_map_id = &"chapter_8_empty_monastery"
spawn_id = &"chapter_start"
