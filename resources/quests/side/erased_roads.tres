[gd_resource type="Resource" script_class="SideQuestDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/side_quest_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/systems/side_quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="SideQuestObjective_1"]
script = ExtResource("2_objective")
objective_id = &"survey_erased_markers"
description = "Khảo sát các mốc đường bị xóa"
required_count = 3

[sub_resource type="Resource" id="SideQuestObjective_2"]
script = ExtResource("2_objective")
objective_id = &"return_map_to_neris"
description = "Trả bản đồ cho Neris"
required_count = 1

[resource]
script = ExtResource("1_definition")
quest_id = &"erased_roads"
title = "Những Con Đường Bị Xóa"
description = "Khôi phục những tuyến đường biến mất khỏi mọi tấm bản đồ."
giver_npc_id = &"neris_cartographer"
objectives = Array[ExtResource("2_objective")]([SubResource("SideQuestObjective_1"), SubResource("SideQuestObjective_2")])
reward_experience = 180
reward_gold = 50
reward_items = {&"restored_city_map": 1}
