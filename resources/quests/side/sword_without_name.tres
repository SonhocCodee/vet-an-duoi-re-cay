[gd_resource type="Resource" script_class="SideQuestDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/side_quest_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/systems/side_quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="SideQuestObjective_1"]
script = ExtResource("2_objective")
objective_id = &"gather_memory_ore"
