[sub_resource type="Resource" id="SideQuestObjective_2"]
script = ExtResource("2_objective")
objective_id = &"report_to_oren"
description = "Báo lại cho Cha Oren"
required_count = 1

[resource]
script = ExtResource("1_definition")
quest_id = &"unrung_bell"
title = "Tiếng Chuông Không Người Kéo"
description = "Điều tra tiếng chuông vọng lên từ thánh đường lúc không có người."
giver_npc_id = &"father_oren"
objectives = Array[ExtResource("2_objective")]([SubResource("SideQuestObjective_1"), SubResource("SideQuestObjective_2")])
