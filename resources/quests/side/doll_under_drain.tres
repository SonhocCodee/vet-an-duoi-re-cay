[sub_resource type="Resource" id="SideQuestObjective_2"]
script = ExtResource("2_objective")
objective_id = &"recover_ivy_doll"
description = "Mang búp bê về cho Ivy"
required_count = 1

[resource]
script = ExtResource("1_definition")
quest_id = &"doll_under_drain"
title = "Búp Bê Dưới Cống"
description = "Tìm lại con búp bê bị cuốn xuống hệ thống cống cũ."
