description = "Thu thập ba loại rễ độc"
required_count = 3

[sub_resource type="Resource" id="SideQuestObjective_2"]
script = ExtResource("2_objective")
objective_id = &"deliver_roots_to_mira"
description = "Đưa rễ độc cho Mira"
