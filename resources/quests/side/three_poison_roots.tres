[resource]
script = ExtResource("1_definition")
quest_id = &"three_poison_roots"
title = "Ba Loài Rễ Độc"
description = "Tìm ba loại rễ độc trước khi chúng lan vào giếng thành phố."
giver_npc_id = &"mira_apothecary"
objectives = Array[ExtResource("2_objective")]([SubResource("SideQuestObjective_1"), SubResource("SideQuestObjective_2")])
