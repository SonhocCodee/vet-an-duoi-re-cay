; Engine configuration file.
config_version=5

[application]
config/name="Vết Ấn Dưới Rễ Cây"
run/main_scene="res://scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameIds="*res://autoload/game_ids.gd"
GameEvents="*res://autoload/game_events.gd"
GameState="*res://autoload/game_state.gd"
SaveService="*res://autoload/save_service.gd"
SceneRouter="*res://autoload/scene_router.gd"
CampaignDirector="*res://autoload/campaign_director.gd"
CityScheduleService="*res://scripts/systems/city_schedule_service.gd"
InventoryService="*res://scripts/systems/inventory_service.gd"
QuestService="*res://scripts/systems/quest_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

