; Engine configuration file.
config_version=5

[application]
config/name="Vết Ấn Dưới Rễ Cây"
run/main_scene="res://scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameIds="*res://autoload/game_ids.gd"
GameEvents="*res://autoload/game_events.gd"
GameState="*res://autoload/game_state.gd"
SaveService="*res://autoload/save_service.gd"
SceneRouter="*res://autoload/scene_router.gd"
CampaignDirector="*res://autoload/campaign_director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="PlayerHitbox"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="Interactables"
2d_physics/layer_7="Triggers"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
